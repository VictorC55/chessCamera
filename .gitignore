# Datasets and source media (large, kept in Google Drive / Roboflow)
pictures/
results/
*.pdf

# Generated debug images
*_refined.jpg
*_refined_refined.jpg
*_debug.jpg
*_fen_debug.jpg

# Logs / scratch
batch_results.txt
*.log

# macOS
.DS_Store
Icon?
EOF